{
  "name": "dsh-sector-ticker",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "A-share sector + gold ticker for the DeepSeek Harness composer dock: day change, 1-minute change, and bold/flashing alerts on sharp moves.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "a-share",
    "stocks",
    "ticker"
  ],
  "license": "MIT",
  "author": "am <lhl2048@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/USER/dsh-sector-ticker.git"
  },
  "homepage": "https://github.com/USER/dsh-sector-ticker#readme",
  "bugs": {
    "url": "https://github.com/USER/dsh-sector-ticker/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
